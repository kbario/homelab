# Repo or org URL the runner registers to
GITHUB_URL=https://github.com/kbario/_kbario

# Display name on GitHub (unique per machine)
RUNNER_NAME=kbed

# Install path on the host (outside this repo)
RUNNER_DIR=/home/kbario/dev/actions-runner

# Optional: pin runner version (default = latest release)
# RUNNER_VERSION=2.336.0

# Optional labels, comma-separated
# RUNNER_LABELS=self-hosted,linux,x64,homelab

# Optional: pass registration token manually instead of fetching via gh
# RUNNER_TOKEN=
