# Tailscale auth key -- generate at https://login.tailscale.com/admin/settings/keys
# Reuse a reusable key from another stack, or mint a new one.
TS_AUTHKEY=tskey-auth-...

# Public URL for this vault (MagicDNS). Required for clients and WebSocket sync.
DOMAIN=https://vaultwarden.<tailnet>.ts.net

# Admin panel token. Generate with:
#   docker run --rm -it vaultwarden/server:latest /vaultwarden hash
# Paste the argon2 hash below (not the raw password).
ADMIN_TOKEN=$argon2id$v=19$m=65540,t=3,p=4$...
