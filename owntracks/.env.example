# Tailscale auth key — generate at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-...

# Recorder MQTT credentials (must match the "recorder" user in mosquitto/config/passwd)
OTR_USER=recorder
OTR_PASS=change-me-recorder-password

# Optional: OpenCage reverse geocoding (addresses on map)
# OTR_GEOKEY=
